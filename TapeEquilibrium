def solution(A):
    """
    Returns the minimum difference between two parts
    of the array after splitting it at every possible position.
    """

    # Calculate the total sum of the array
    total_sum = sum(A)

    # Keeps track of the sum on the left side
    left_sum = 0

    # Start with a very large minimum difference
    min_difference = float('inf')

    # Split positions from 1 to N-1
    for i in range(len(A) - 1):

        # Add current element to the left side
        left_sum += A[i]

        # Remaining elements belong to the right side
        right_sum = total_sum - left_sum

        # Calculate the absolute difference
        difference = abs(left_sum - right_sum)

        # Update minimum difference if a smaller one is found
        if difference < min_difference:
            min_difference = difference

    # Return the smallest difference found
    return min_difference


# Test cases
print(solution([3, 1, 2, 4, 3]))
print(solution([1, 2]))
print(solution([5, 6, 2, 4, 1]))
